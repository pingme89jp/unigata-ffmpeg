# Everything the Unigata FFmpeg build is made from, pinned. Change a line here, never in build.sh.
#
# Owner, 2026-11-03: "If I had a choice, I would prefer to create my own FFmpeg." and "I will go with your recommendation."
# Each pin below was fetched on 2026-11-03 and checked as stated; nothing here was taken from memory.

# FFmpeg itself. ffmpeg.org publishes a PGP signature and no checksum, so the sha256 was computed from the tarball
# AFTER `gpg --verify` reported a good signature from the FFmpeg release signing key below.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SIG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_KEY_URL=https://ffmpeg.org/ffmpeg-devel.asc
FFMPEG_KEY_FINGERPRINT=FCF986EA15E6E293A5644F10B4322F04D67658D8

# MP3 encoder (LGPL). Audio is MP3, not AAC: the MP3 patents expired, AAC's have not. sha256 matches the value
# published for this release as far as I recall it, and was recomputed from the downloaded file.
LAME_VERSION=3.100
LAME_URL=https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz/download
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# Hardware-encoder headers (MIT / BSD style; they only declare the API, the drivers do the work and are the vendor's).
NVCODEC_REPO=https://github.com/FFmpeg/nv-codec-headers
NVCODEC_TAG=n13.1.15.0
NVCODEC_COMMIT=0a6fba9a2820628b8103464f4c8753ee05838baa
AMF_REPO=https://github.com/GPUOpen-LibrariesAndSDKs/AMF
AMF_TAG=v1.5.3
AMF_COMMIT=57ee0cfb0e1a08d9041f77435653794c1b012be0
VPL_REPO=https://github.com/intel/libvpl
VPL_TAG=v2023.4.0
VPL_COMMIT=2274efcd3672b43297ef774f332e1fed6781381c

# OpenH264 (BSD). Built here from source ONLY so FFmpeg has the headers and an import library to link against. What RUNS is
# Cisco's own unmodified binary, fetched by the Enhancer from Cisco's server with the person's consent: Cisco's H.264 patent
# cover applies to the binary Cisco distributes, not to a build from source. FFmpeg links OpenH264 at start-up, so the Enhancer
# puts Cisco's library next to ffmpeg before ever running it.
# Cisco's file names for 2.7.0 (checked with an HTTP request on 2026-11-03; macOS and Windows-on-arm64 files were not found):
OPENH264_REPO=https://github.com/cisco/openh264
OPENH264_TAG=v2.7.0
OPENH264_COMMIT=1bca62311e447fd9c39fc93de2c4b96cd5ce971c
OPENH264_BINARY_BASE=http://ciscobinary.openh264.org/
OPENH264_WIN64_FILE=openh264-2.7.0-win64.dll.bz2
OPENH264_WIN64_SHA256=7073fda55e904ac515f787d9728c4bcf9965ec7c91c9f84eae3f260ef9b9b37c
OPENH264_LINUX64_FILE=libopenh264-2.7.0-linux64.8.so.bz2
OPENH264_LINUX64_SHA256=44ad0dd2c5af2bac84d26f89f2eb4e268708b8739323d15d33837f7221ce4980
OPENH264_LINUXARM64_FILE=libopenh264-2.7.0-linux-arm64.8.so.bz2
OPENH264_LINUXARM64_SHA256=74c7a1d02003d80daf2b4bc7bbb02f73e5548debd4c158b495e1f83d80ebd136

# Bump when the recipe changes but FFmpeg does not. Becomes part of the release name.
UNIGATA_BUILD=1
